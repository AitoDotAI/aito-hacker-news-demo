# Aito predictive database connection.
# Local dev: copy this to .env, fill in values, then `./do dev`.
# Production: aito-demo-server/.env.local supplies AITO_<DEMO_NAME>_* and the
# yaml's `env:` block remaps to AITO_API_URL / AITO_API_KEY.
AITO_API_URL=https://shared.aito.ai/db/your-db-here
AITO_API_KEY=your-read-only-key-here

# Optional: query a named Aito environment (a branch of master) instead of
# master itself. Envs are how we stage a new corpus without disturbing the
# data production is serving — master stays on the shipped version while a
# branch gets rebuilt and evaluated.
#
#   list:   GET  $AITO_API_URL/api/v2/_envs
#   create: POST $AITO_API_URL/api/v2/_envs  {"name":"v2","basedOn":"env.master"}
#   query:  $AITO_API_URL/env/v2/api/v1/...   (handled by Config.api_base)
#
# Leave unset (or "master") to talk to master.
#AITO_ENV=v2
